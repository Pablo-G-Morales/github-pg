<%- include('../partials/header', { title }) %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title mb-3">Nueva imagen para el Dashboard</h5>

          <form action="/admin/dashboard-imagenes" method="post" enctype="multipart/form-data" class="vstack gap-3">
            <div>
              <label class="form-label">Título (opcional)</label>
              <input type="text" class="form-control" name="titulo" maxlength="150" placeholder="Ej. Promoción de noviembre">
            </div>

            <div>
              <label class="form-label">Imagen</label>
              <input type="file" class="form-control" name="imagen" accept="image/*" required>
              <div class="form-text">Formatos: PNG/JPG/WEBP/GIF. Se mostrará reducida en el dashboard.</div>
            </div>

            <div>
              <label class="form-label">Orden (mayor aparece primero)</label>
              <input type="number" class="form-control" name="sort_order" value="0">
            </div>

            <div class="d-flex gap-2">
              <button class="btn btn-primary" type="submit">Guardar</button>
              <a href="/admin/dashboard-imagenes" class="btn btn-outline-secondary">Cancelar</a>
            </div>
          </form>

        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
