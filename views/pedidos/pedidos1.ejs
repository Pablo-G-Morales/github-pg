<%- include('../partials/header', { title }) %>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"/>

<style>
  :root{ --srex-primary:#2b2e62; --srex-accent:#00bb00; }
  .card-cubo{
    background:var(--srex-primary); color:#fff; width:230px; border-radius:1rem;
    box-shadow:0 4px 10px rgba(0,0,0,.25); transition:transform .15s ease-in-out;
  }
  .card-cubo:hover{transform:scale(1.04);}
  .card-cubo .btn{background:var(--srex-accent); border:none;}
  .card-cubo .btn:hover{filter:brightness(.95);}
</style>

<div class="container-fluid py-4">
  <header class="mb-4 d-flex align-items-center justify-content-between">
    <div>
      <h1 class="h2 fw-bold mb-1">Pedidos</h1>
      <p class="text-muted mb-0">Accesos rápidos para crear pedidos y administrar catálogos.</p>
    </div>
  
  </header>

  <div class="row g-4 justify-content-center">
    <!-- Nuevo pedido -->
    <div class="col-6 col-md-3 d-flex justify-content-center">
      <div class="card card-cubo p-3 text-center d-flex flex-column align-items-center">
        <i class="fa-solid fa-file-circle-plus fa-2x mb-2"></i>
        <small class="fw-semibold flex-grow-1">Nuevo pedido</small>
        <a href="/pedidos/nuevo" class="btn btn-sm mt-2 px-3">Crear</a>
      </div>
    </div>

    <!-- Pedidos registrados -->
    <div class="col-6 col-md-3 d-flex justify-content-center">
      <div class="card card-cubo p-3 text-center d-flex flex-column align-items-center">
        <i class="fa-solid fa-list-check fa-2x mb-2"></i>
        <small class="fw-semibold flex-grow-1">Pedidos registrados</small>
        <a href="/pedidos" class="btn btn-sm mt-2 px-3">Ver</a>
      </div>
    </div>

      <!-- Completar Pedidos -->
    <div class="col-6 col-md-3 d-flex justify-content-center">
      <div class="card card-cubo p-3 text-center d-flex flex-column align-items-center">
        <i class="fa-solid fa-clipboard-check fa-2x mb-2"></i>
        <small class="fw-semibold flex-grow-1">Completar Pedidos</small>
        <a href="/pedidos/autorizar/lista" class="btn btn-sm mt-2 px-3">Ver</a>
      </div>
    </div>

    <!-- Formas de pago -->
    <div class="col-6 col-md-3 d-flex justify-content-center">
      <div class="card card-cubo p-3 text-center d-flex flex-column align-items-center">
        <i class="fa-regular fa-credit-card fa-2x mb-2"></i>
        <small class="fw-semibold flex-grow-1">Formas de pago</small>
        <a href="/catalogos/formas-pago" class="btn btn-sm mt-2 px-3">Administrar</a>
      </div>
    </div>

    <!-- Departamentos -->
    <div class="col-6 col-md-3 d-flex justify-content-center">
      <div class="card card-cubo p-3 text-center d-flex flex-column align-items-center">
        <i class="fa-solid fa-map-location-dot fa-2x mb-2"></i>
        <small class="fw-semibold flex-grow-1">Departamentos</small>
        <a href="/pedidos/departamentos" class="btn btn-sm mt-2 px-3">Administrar</a>
      </div>
    </div>

    <!-- Municipios -->
    <div class="col-6 col-md-3 d-flex justify-content-center">
      <div class="card card-cubo p-3 text-center d-flex flex-column align-items-center">
        <i class="fa-solid fa-location-dot fa-2x mb-2"></i>
        <small class="fw-semibold flex-grow-1">Municipios</small>
        <a href="/pedidos/municipios" class="btn btn-sm mt-2 px-3">Administrar</a>
      </div>
    </div>

    <!-- Registrar devoluciones (solo admin) -->
    <% if (user && user.rol_id === 1) { %>
    <div class="col-6 col-md-3 d-flex justify-content-center">
      <div class="card card-cubo p-3 text-center d-flex flex-column align-items-center">
        <i class="fa-solid fa-rotate-left fa-2x mb-2"></i>
        <small class="fw-semibold flex-grow-1">Registrar devoluciones</small>
        <a href="/devoluciones-ventas" class="btn btn-sm mt-2 px-3">Elegir pedido</a>
      </div>
    </div>
    <% } %>

    
  </div>
</div>

<%- include('../partials/footer') %>
