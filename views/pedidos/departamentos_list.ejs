<%- include('../partials/header', { title }) %>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0">Departamentos</h2>
    <a href="/pedidos/departamentos/nuevo" class="btn btn-success">
      <i class="fa fa-plus"></i> Nuevo
    </a>
  </div>

  <div class="table-responsive">
    <table id="tblDeps" class="table table-sm table-striped align-middle">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Nombre</th>
          <th>Creado por</th>
          <th>Creado en</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% (items||[]).forEach(it => { %>
          <tr>
            <td><%= it.id %></td>
            <td><%= it.nombre %></td>
            <td><%= it.creado_por_nombre || '—' %></td>
            <td><%= it.creado_en ? new Date(it.creado_en).toLocaleString() : '—' %></td>
            <td class="text-nowrap">
              <a href="/pedidos/departamentos/<%= it.id %>" class="btn btn-sm btn-info me-1">
                <i class="fa fa-eye"></i> Ver
              </a>
              <a href="/pedidos/departamentos/<%= it.id %>/editar" class="btn btn-sm btn-primary">
                <i class="fa fa-pen"></i> Editar
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script>
  $(function(){
    $('#tblDeps').DataTable({
      order: [[0,'desc']],
      pageLength: 10,
      language:{
        search:"Buscar:",
        lengthMenu:"Mostrar _MENU_ registros",
        info:"_START_–_END_ de _TOTAL_",
        infoEmpty:"0–0 de 0",
        emptyTable:"Sin resultados",
        paginate:{ previous:"Anterior", next:"Siguiente" }
      },
      columnDefs: [
        { targets: [4], orderable: false },
        { targets: 0, width: 70 }
      ]
    });
  });
</script>
<%- include('../partials/footer') %>
