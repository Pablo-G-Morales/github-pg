<%- include('../partials/header', { title }) %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0"><%= title %></h2>
    <div class="d-flex gap-2">
      <a href="/pedidos/cierres" class="btn btn-outline-secondary">
        <i class="fa fa-arrow-left"></i> Volver
      </a>
      <a href="/pedidos/<%= cierre.pedido_id %>" class="btn btn-primary">Ver pedido</a>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-3"><strong>Pedido:</strong> #<%= cierre.pedido_id %></div>
        <div class="col-md-3"><strong>Proveedor:</strong> <%= cierre.proveedor_nombre || '—' %></div>
        <div class="col-md-3"><strong>Bodega:</strong> <%= cierre.bodega_nombre || '—' %></div>
        <div class="col-md-3"><strong>Fecha pedido:</strong> <%= cierre.fecha_pedido ? new Date(cierre.fecha_pedido).toLocaleString() : '—' %></div>
        <div class="col-md-3"><strong>Total:</strong> Q <%= Number(cierre.total||0).toFixed(2) %></div>
        <div class="col-md-3"><strong>Número documento:</strong> <%= cierre.numero_documento || '—' %></div>
        <div class="col-md-6">
          <strong>Archivo:</strong>
          <% if (cierre.archivo_path) { %>
            <a href="<%= cierre.archivo_path %>" target="_blank" class="btn btn-sm btn-outline-secondary">
              <i class="fa fa-file"></i> Ver
            </a>
          <% } else { %>—<% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Producto</th>
          <th class="text-end">Cantidad</th>
          <th class="text-end">Precio</th>
          <th class="text-end">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% let total = 0; (detalles||[]).forEach((d,i)=>{ const sub = Math.floor(Number(d.cantidad||0))*Number(d.precio_unitario||0); total+=sub; %>
          <tr>
            <td><%= i+1 %></td>
            <td><%= d.producto_nombre || ('#'+d.producto_id) %></td>
            <td class="text-end"><%= Math.floor(Number(d.cantidad||0)) %></td>
            <td class="text-end">Q <%= Number(d.precio_unitario||0).toFixed(2) %></td>
            <td class="text-end">Q <%= sub.toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <th colspan="4" class="text-end">Total</th>
          <th class="text-end">Q <%= Number(total||0).toFixed(2) %></th>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
