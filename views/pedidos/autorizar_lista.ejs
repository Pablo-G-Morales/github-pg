<!-- views/pedidos/autorizar_lista.ejs -->
<%- include('../partials/header', { title }) %>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0"><%= title %></h3>
    <a href="/pedidos" class="btn btn-outline-secondary">Volver a pedidos</a>
  </div>

  <div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
      <thead class="table-dark">
        <tr>
          <th>Pedido</th>         <!-- NUEVO: ID -->
          <th>Fecha</th>
          <th>Estado</th>
          <th>Cliente</th>
          <th>Bodega</th>
          <th class="text-end">Total</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% (items || []).forEach(p => { %>
          <tr>
            <td>
              <a href="/pedidos/<%= p.id %>">#<%= p.id %></a>
            </td>
            <td>
              <%= p.fecha_pedido
                    ? new Date(p.fecha_pedido).toLocaleString('es-GT', { hour12: true })
                    : (p.created_at ? new Date(p.created_at).toLocaleString('es-GT', { hour12: true }) : '—') %>
            </td>
            <td>
              <% const cls =
                    p.estado === 'COMPLETADO' ? 'bg-success' :
                    p.estado === 'EN_PROCESO' ? 'bg-info' :
                    p.estado === 'ANULADO'    ? 'bg-danger' :
                                                'bg-warning text-dark'; %>
              <span class="badge <%= cls %>"><%= p.estado %></span>
            </td>
            <td><%= p.nom_nuevo || p.cliente || 'Consumidor final' %></td>
            <td><%= p.bodega_nombre || (p.bodega_id ? ('#' + p.bodega_id) : '—') %></td>
            <td class="text-end">Q <%= Number(p.total || 0).toFixed(2) %></td>
            <td class="text-end text-nowrap">
              <a href="/pedidos/<%= p.id %>" class="btn btn-sm btn-outline-secondary">
                Ver ficha
              </a>
              <a href="/pedidos/autorizar/<%= p.id %>" class="btn btn-sm btn-primary ms-1">
                Autorizar
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (!items || items.length === 0) { %>
    <div class="alert alert-info">No hay pedidos pendientes de autorización.</div>
  <% } %>
</div>

<%- include('../partials/footer') %>
