<%- include('../partials/header', { title }) %>

<div class="container py-4">
  <h2 class="h4 mb-3"><%= title %></h2>

  <form method="post" action="/pedidos/departamentos/<%= dep.id %>/editar" class="card p-3">
    <div class="mb-3">
      <label class="form-label">Nombre</label>
      <input name="nombre" class="form-control" required maxlength="100" value="<%= dep.nombre %>">
    </div>

    <div class="text-end">
      <a href="/pedidos/departamentos/<%= dep.id %>" class="btn btn-secondary">Cancelar</a>
      <button class="btn btn-primary"><i class="fa fa-save"></i> Actualizar</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
