<%- include('../partials/header', { title }) %>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0"><%= title %></h2>
    <a href="/pedidos/autorizar" class="btn btn-outline-secondary">
      <i class="fa fa-arrow-left"></i> Autorizar
    </a>
  </div>

  <div class="table-responsive">
    <table id="tblCierres" class="table table-sm table-striped align-middle">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Pedido</th>
          <th>Proveedor</th>
          <th>Bodega</th>
          <th>Fecha pedido</th>
          <th class="text-end">Total</th>
          <th>Documento</th>
          <th>Archivo</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% (items||[]).forEach(it => { %>
          <tr>
            <td><%= it.id %></td>
            <td><a class="link-primary" href="/pedidos/<%= it.pedido_id %>">#<%= it.pedido_id %></a></td>
            <td><%= it.proveedor_nombre || '—' %></td>
            <td><%= it.bodega_nombre || '—' %></td>
            <td><%= it.fecha_pedido ? new Date(it.fecha_pedido).toLocaleString() : '—' %></td>
            <td class="text-end">Q <%= Number(it.total||0).toFixed(2) %></td>
            <td><%= it.numero_documento || '—' %></td>
            <td>
              <% if (it.archivo_path) { %>
                <a href="<%= it.archivo_path %>" target="_blank" class="btn btn-sm btn-outline-secondary">Ver</a>
              <% } else { %>—<% } %>
            </td>
            <td class="text-nowrap">
              <a class="btn btn-sm btn-info" href="/pedidos/cierres/<%= it.id %>">
                <i class="fa fa-eye"></i> Ver
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script>
  $(function(){
    $('#tblCierres').DataTable({
      order: [[0, 'desc']],
      pageLength: 10,
      language:{
        search:"Buscar:", lengthMenu:"Mostrar _MENU_",
        info:"_START_–_END_ de _TOTAL_", infoEmpty:"0–0 de 0",
        emptyTable:"Sin datos", paginate:{previous:"Anterior", next:"Siguiente"}
      },
      columnDefs: [{ targets: [7,8], orderable:false }]
    });
  });
</script>

<%- include('../partials/footer') %>
