<%- include('../partials/header', { title }) %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

<style>
  .thumb { width:100%; aspect-ratio: 4 / 3; overflow:hidden; border-radius:.5rem; background:#0b0f1a14; }
  .thumb > img { width:100%; height:100%; object-fit:cover; display:block; }
  .card-item { transition: transform .12s ease, box-shadow .12s ease; border-radius:.75rem; }
  .card-item:hover { transform: translateY(-2px); box-shadow: 0 0.35rem 1rem rgba(0,0,0,.08); }
  .price { font-weight:700; font-size:1.05rem; }
  .qty-input { max-width: 92px; }
  .skeleton{ animation: sk 1.1s linear infinite alternate; background: linear-gradient(90deg, #0000 0%, #0001 50%, #0000 100%); }
  @keyframes sk { from { background-position:-120% 0 } to { background-position:220% 0 } }
</style>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0"><%= title %></h2>
    <div class="d-flex gap-2">
      <button id="btnCart" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#cartModal">
        Carrito <span class="badge bg-primary" id="cartCount">0</span>
      </button>
      <button id="btnReset" class="btn btn-outline-secondary">Reiniciar</button>
    </div>
  </div>

  <!-- Datos del cliente -->
  <div class="card mb-3">
    <div class="card-header fw-semibold">Datos del cliente</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Nombre</label>
          <input id="nom_nuevo" name="nom_nuevo" type="text" class="form-control" placeholder="Nombre del cliente" autocomplete="off">
          <div class="form-text">Si lo dejas vacío se usará “Consumidor final”.</div>
        </div>
        <div class="col-md-6">
          <label class="form-label">Teléfono</label>
          <input id="tel_nuevo" name="tel_nuevo" type="text" class="form-control" placeholder="Teléfono" autocomplete="off">
        </div>
      </div>
    </div>
  </div>

  <!-- Cabecera -->
  <div class="row g-3 mb-3">
    <div class="col-md-3">
      <label class="form-label">Bodega (requerido)</label>
      <select id="bodega_id" class="form-select" required>
        <option value="">— Seleccionar —</option>
        <% (bodegas||[]).forEach(b => { %>
          <option value="<%= b.id %>"><%= b.nombre %></option>
        <% }) %>
      </select>
      <div class="form-text">Determina stock disponible.</div>
    </div>

    <div class="col-md-3">
      <label class="form-label">Fecha y hora de Entrega</label>
      <input id="fecha_pedido" type="datetime-local" class="form-control">
    </div>

    <div class="col-md-3">
      <label class="form-label">Notas</label>
      <input id="notas" class="form-control" placeholder="Opcional">
    </div>

    <div class="col-md-3">
      <label class="form-label">Departamento</label>
      <select id="departamento_id" class="form-select" required>
        <option value="">— Seleccionar —</option>
        <% (departamentos||[]).forEach(d => { %>
          <option value="<%= d.id %>"><%= d.nombre %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-md-3">
      <label class="form-label">Municipio</label>
      <select id="municipio_id" class="form-select" required disabled>
        <option value="">— Selecciona un departamento —</option>
      </select>
    </div>

    <div class="col-md-6">
      <label class="form-label">Dirección</label>
      <input id="direccion" class="form-control" placeholder="Dirección de entrega / referencia" required>
    </div>

    <div class="col-md-6">
      <label class="form-label">Diseño (JPG/PNG/PDF/WebP)</label>
      <input id="diseno" type="file" class="form-control" accept=".png,.jpg,.jpeg,.webp,.pdf">
      <div class="form-text">Opcional, máx. 25MB.</div>
      <div id="prevWrap" class="mt-2 d-none">
        <small class="text-muted">Vista previa:</small>
        <div id="preview" class="border rounded p-2"></div>
      </div>
    </div>

    <div class="col-md-6 d-flex align-items-end justify-content-end">
      <div class="input-group" style="max-width:480px;">
        <input id="search" class="form-control" placeholder="Buscar por nombre…">
        <button id="btnBuscar" class="btn btn-outline-primary">Buscar</button>
      </div>
    </div>
  </div>

  <!-- Mensajes -->
  <div id="warnBodega" class="alert alert-warning d-none">Selecciona una <b>bodega</b> para ver stock y agregar productos.</div>
  <div id="catalogMsg" class="alert alert-info d-none"></div>

  <!-- Catálogo -->
  <div id="grid" class="row g-3"></div>

  <div class="text-end mt-3">
    <button id="btnGuardar" class="btn btn-success">
      <i class="fa fa-save me-1"></i> Guardar pedido
    </button>
  </div>
</div>

<!-- Modal Carrito -->
<div class="modal fade" id="cartModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Carrito</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead class="table-light">
              <tr>
                <th>Producto</th>
                <th class="text-end">Stock</th>
                <th class="text-end">Cant.</th>
                <th class="text-end">Precio</th>
                <th class="text-end">Subtotal</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="cartBody"></tbody>
            <tfoot>
              <tr>
                <th colspan="4" class="text-end">Total</th>
                <th class="text-end" id="cartTotal">Q 0.00</th>
                <th></th>
              </tr>
            </tfoot>
          </table>
        </div>
        <div id="cartEmpty" class="text-center text-muted py-4 d-none">El carrito está vacío.</div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        <button id="cartClean" class="btn btn-outline-danger">Vaciar</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(() => {
  const $  = s => document.querySelector(s);

  const state = {
    bodega_id: null,
    items: [] // { producto_id, nombre, precio, cantidad, stock }
  };

  const fmtQ = n => 'Q ' + Number(n||0).toFixed(2);
  const updCartBadge = () => { $('#cartCount').textContent = state.items.reduce((a,b)=>a+Number(b.cantidad||0),0); };

  const msg = {
    show(id, text, cls='alert-info'){
      const el = $(id);
      el.className = 'alert ' + cls;
      el.textContent = text;
      el.classList.remove('d-none');
    },
    hide(id){ $(id).classList.add('d-none'); }
  };

  /* ---------- RENDER GRID ---------- */
  function renderGrid(items, { loading=false } = {}) {
    const g = $('#grid');
    g.innerHTML = '';

    if (!state.bodega_id) {
      msg.show('#warnBodega', 'Selecciona una bodega para mostrar el catálogo.', 'alert-warning');
      return;
    } else {
      msg.hide('#warnBodega');
    }

    if (loading) {
      for (let i=0;i<8;i++){
        g.insertAdjacentHTML('beforeend', `
          <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-item h-100">
              <div class="card-body">
                <div class="thumb skeleton mb-3" style="height:140px;border-radius:.5rem;"></div>
                <div class="skeleton mb-2" style="height:16px;border-radius:4px;"></div>
                <div class="skeleton mb-2" style="height:16px;width:70%;border-radius:4px;"></div>
                <div class="skeleton" style="height:36px;border-radius:6px;"></div>
              </div>
            </div>
          </div>
        `);
      }
      return;
    }

    if (!items || !items.length) {
      msg.show('#catalogMsg', 'Sin resultados para esta bodega/búsqueda.', 'alert-info');
      return;
    } else {
      msg.hide('#catalogMsg');
    }

    items.forEach(it => {
      const stock = Number(it.stock ?? 0);
      const disabled = stock <= 0 ? 'disabled' : '';
      g.insertAdjacentHTML('beforeend', `
        <div class="col-12 col-sm-6 col-lg-3">
          <div class="card card-item h-100">
            <div class="card-body d-flex flex-column">
              <div class="thumb mb-3"><img src="${it.imagen}" alt=""></div>
              <div class="text-muted mb-1">Stock: ${stock.toLocaleString('es-GT')}</div>
              <div class="fw-semibold mb-1">${it.nombre}</div>
              <div class="price mb-2">${fmtQ(it.precio)}</div>
              <div class="mt-auto d-flex gap-2">
                <input type="number" class="form-control qty-input" min="1" max="${Math.max(stock,1)}" step="1" value="1"
                       data-q-id="q-${it.id}" ${disabled}>
                <button class="btn btn-primary add" data-id="${it.id}"
                        data-nombre="${it.nombre.replace(/"/g,'&quot;')}"
                        data-precio="${Number(it.precio)}" data-stock="${stock}" ${disabled}>
                  <i class="fa fa-plus"><b>+</b></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      `);
    });
  }

  /* ---------- LOAD CATALOG ---------- */
  async function loadCatalog() {
    const bodegaId = Number($('#bodega_id').value) || 0;
    const q = ($('#search').value || '').trim();
    state.bodega_id = bodegaId || null;

    if (!bodegaId) { renderGrid([], { loading:false }); return; }

    renderGrid([], { loading:true });

    try {
      const params = new URLSearchParams({ bodega_id: bodegaId });
      if (q) params.set('search', q);
      const r = await fetch('/pedidos/api/catalog?' + params.toString(), { headers:{ 'Accept':'application/json' } });
      if (!r.ok) throw new Error('HTTP '+r.status);
      const d = await r.json();
      const items = Array.isArray(d.items) ? d.items : [];
      renderGrid(items);
    } catch (err) {
      console.error('Catalog error:', err);
      renderGrid([], { loading:false });
      msg.show('#catalogMsg', 'No se pudo cargar el catálogo. Reintenta o cambia de bodega.', 'alert-danger');
    }
  }

  /* ---------- CARRITO ---------- */
  function renderCart() {
    const tb = document.querySelector('#cartBody'); tb.innerHTML = '';
    const empty = state.items.length === 0;
    document.querySelector('#cartEmpty').classList.toggle('d-none', !empty);
    if (empty) { document.querySelector('#cartTotal').textContent = fmtQ(0); updCartBadge(); return; }

    let total = 0;
    state.items.forEach((it, idx) => {
      const sub = Number(it.cantidad) * Number(it.precio);
      total += sub;
      tb.insertAdjacentHTML('beforeend', `
        <tr>
          <td>${it.nombre}</td>
          <td class="text-end">${it.stock}</td>
          <td class="text-end" style="max-width:110px;">
            <input type="number" class="form-control form-control-sm qty" min="1" step="1"
                   max="${it.stock}" value="${it.cantidad}" data-idx="${idx}">
          </td>
          <td class="text-end">${fmtQ(it.precio)}</td>
          <td class="text-end">${fmtQ(sub)}</td>
          <td class="text-end">
            <button class="btn btn-sm btn-link text-danger del" data-idx="${idx}">Quitar</button>
          </td>
        </tr>
      `);
    });
    document.querySelector('#cartTotal').textContent = fmtQ(total);
    updCartBadge();
  }

  function addItem({ id, nombre, precio, stock, cantidad }) {
    if (!state.bodega_id) { alert('Selecciona bodega.'); return; }
    const k = state.items.findIndex(x => x.producto_id===id);
    const qty = Math.max(1, Math.min(Number(cantidad||1), Number(stock||0) || 1));
    if (k >= 0) {
      const nueva = Math.min(state.items[k].cantidad + qty, Math.max(state.items[k].stock,1));
      state.items[k].cantidad = nueva;
    } else {
      state.items.push({ producto_id:id, nombre, precio:Number(precio||0), cantidad:qty, stock:Number(stock||0) });
    }
    renderCart();
  }

  /* ---------- DEP → MUNI ---------- */
  async function loadMunicipios() {
    const depId = Number($('#departamento_id').value) || 0;
    const muni = $('#municipio_id');
    muni.innerHTML = '<option value="">— Seleccionar —</option>';
    muni.disabled = !depId;
    if (!depId) return;
    const r = await fetch(`/pedidos/api/municipios?departamento_id=${depId}`);
    const data = await r.json();
    (data.items||[]).forEach(m => {
      const o = document.createElement('option');
      o.value = m.id; o.textContent = m.nombre;
      muni.appendChild(o);
    });
  }

  /* ---------- EVENTOS UI ---------- */
  $('#bodega_id').addEventListener('change', loadCatalog);
  $('#btnBuscar').addEventListener('click', (e)=>{ e.preventDefault(); loadCatalog(); });

  let t=null;
  $('#search').addEventListener('input', ()=>{ clearTimeout(t); t=setTimeout(loadCatalog, 250); });

  $('#departamento_id').addEventListener('change', loadMunicipios);

  // Click en tarjetas (+)
  $('#grid').addEventListener('click', (e) => {
    const btn = e.target.closest('button.add'); if (!btn) return;
    const id    = Number(btn.dataset.id);
    const stock = Number(btn.dataset.stock);
    const precio= Number(btn.dataset.precio);
    const nombre= btn.dataset.nombre;
    const qtyInput = btn.parentElement.querySelector('.qty-input');
    const qty = Math.max(1, Math.min(Number(qtyInput.value || 1), Math.max(stock,1)));
    addItem({ id, nombre, precio, stock, cantidad: qty });
    const cartModal = new bootstrap.Modal('#cartModal'); cartModal.show();
  });

  // Edición dentro del carrito
  $('#cartBody').addEventListener('input', (e) => {
    if (!e.target.classList.contains('qty')) return;
    const idx = Number(e.target.dataset.idx);
    let v = Math.floor(Number(e.target.value || 1));
    if (v < 1) v = 1;
    if (v > state.items[idx].stock) v = state.items[idx].stock || 1;
    state.items[idx].cantidad = v;
    renderCart();
  });

  $('#cartBody').addEventListener('click', (e) => {
    if (!e.target.classList.contains('del')) return;
    const idx = Number(e.target.dataset.idx);
    state.items.splice(idx,1);
    renderCart();
  });

  $('#cartClean').addEventListener('click', () => { state.items = []; renderCart(); });

  $('#btnReset').addEventListener('click', () => {
    $('#bodega_id').value = '';
    $('#fecha_pedido').value = '';
    $('#notas').value = '';
    $('#direccion').value = '';
    $('#departamento_id').value = '';
    $('#municipio_id').innerHTML = '<option value="">— Seleccionar —</option>';
    $('#municipio_id').disabled = true;
    $('#diseno').value = '';
    $('#preview').innerHTML = ''; $('#prevWrap').classList.add('d-none');
    // cliente
    $('#nom_nuevo').value = '';
    $('#tel_nuevo').value = '';
    // carrito
    state.items = [];
    renderCart();
    renderGrid([], { loading:false });
    msg.show('#warnBodega','Selecciona una bodega para mostrar el catálogo.','alert-warning');
  });

  // Preview diseño
  $('#diseno').addEventListener('change', () => {
    const f = $('#diseno').files[0];
    const prev = $('#preview');
    prev.innerHTML = '';
    if (!f) { $('#prevWrap').classList.add('d-none'); return; }
    $('#prevWrap').classList.remove('d-none');
    if (f.type.includes('pdf')) {
      prev.innerHTML = `<div class="p-2 bg-light rounded"><i class="fa fa-file-pdf me-2"></i>${f.name}</div>`;
    } else {
      const url = URL.createObjectURL(f);
      prev.innerHTML = `<img src="${url}" class="img-fluid rounded" style="max-height:200px;">`;
    }
  });

  // Inicializa: si hay bodega preseleccionada, carga de una vez
  state.bodega_id = Number($('#bodega_id').value) || null;
  if (state.bodega_id) loadCatalog(); else renderGrid([], { loading:false });
  renderCart(); updCartBadge();

  /* ---------- GUARDAR ---------- */
  $('#btnGuardar').addEventListener('click', async () => {
    if (!state.bodega_id) { alert('Selecciona una bodega.'); return; }
    if (!$('#departamento_id').value || !$('#municipio_id').value) { alert('Selecciona departamento y municipio.'); return; }
    if (!$('#direccion').value.trim()) { alert('Ingresa una dirección.'); return; }
    if (state.items.length === 0) { alert('Agrega productos al carrito.'); return; }

    const nom_nuevo = ($('#nom_nuevo').value || '').trim();
    const tel_nuevo = ($('#tel_nuevo').value || '').trim();

    const fd = new FormData();
    fd.append('nom_nuevo', nom_nuevo);
    fd.append('tel_nuevo', tel_nuevo);
    // Cabecera (sin proveedor)
    fd.append('bodega_id', $('#bodega_id').value);
    fd.append('departamento_id', $('#departamento_id').value);
    fd.append('municipio_id', $('#municipio_id').value);
    fd.append('fecha_pedido', $('#fecha_pedido').value || '');
    fd.append('direccion', $('#direccion').value || '');
    fd.append('notas', $('#notas').value || '');
    if ($('#diseno').files[0]) fd.append('diseno', $('#diseno').files[0]);

    // Items
    const itemsPayload = state.items.map(it => ({
      producto_id: it.producto_id,
      cantidad: Math.floor(Number(it.cantidad||0)),
      precio_unitario: Number(it.precio||0)
    }));
    fd.append('items', JSON.stringify(itemsPayload));

    const r = await fetch('/pedidos', { method:'POST', body: fd });
    let data = {};
    try { data = await r.json(); } catch {}
    if (data.ok && data.redirect) {
      location.href = data.redirect;
    } else {
      alert(data.message || 'No se pudo guardar el pedido.');
      console.error('Respuesta del servidor:', data);
    }
  });
})();
</script>

<%- include('../partials/footer') %>
