<%- include('../partials/header', { title }) %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0"><i class="fa fa-undo"></i> <%= title %></h2>
  </div>

  <!-- Pestañas -->
  <ul class="nav nav-tabs mb-3" id="dvTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="tab-pedidos-tab" data-bs-toggle="tab" data-bs-target="#tab-pedidos" type="button" role="tab" aria-controls="tab-pedidos" aria-selected="true">
        Pedidos COMPLETADOS
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="tab-devoluciones-tab" data-bs-toggle="tab" data-bs-target="#tab-devoluciones" type="button" role="tab" aria-controls="tab-devoluciones" aria-selected="false">
        Devoluciones registradas
      </button>
    </li>
  </ul>

  <div class="tab-content" id="dvTabsContent">
    <!-- TAB 1: Pedidos COMPLETADOS -->
    <div class="tab-pane fade show active" id="tab-pedidos" role="tabpanel" aria-labelledby="tab-pedidos-tab" tabindex="0">
      <div class="card">
        <div class="card-body">
          <div class="row g-2 align-items-center mb-2">
            <div class="col-sm-6 col-md-4">
              <input id="searchPedidos" type="text" class="form-control form-control-sm" placeholder="Buscar (ID, cliente, fecha, total)">
            </div>
            <div class="col-auto ms-auto d-flex align-items-center gap-2">
              <label class="form-label m-0 small">Filas por página</label>
              <select id="ppPedidos" class="form-select form-select-sm" style="width:auto;">
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-sm table-striped align-middle" id="tblPedidos">
              <thead class="table-light">
                <tr>
                  <th>Pedido</th>
                  <th>Fecha</th>
                  <th>Cliente</th>
                  <th class="text-end">Total</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% if (pedidosCompletados && pedidosCompletados.length) { %>
                  <% pedidosCompletados.forEach(p => { %>
                    <tr>
                      <td>#<%= p.id %></td>
                      <td><%= new Date(p.created_at).toLocaleString() %></td>
                      <td><%= p.nom_nuevo || 'Consumidor final' %></td>
                      <td class="text-end">Q <%= Number(p.total || 0).toFixed(2) %></td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-warning" href="/devoluciones-ventas/pedido/<%= p.id %>/nueva">
                          <i class="fa fa-undo"></i> Devolver
                        </a>
                        <button
                          type="button"
                          class="btn btn-sm btn-outline-secondary btn-ficha"
                          data-url="/pedidos/<%= p.id %>"
                          data-pedido="<%= p.id %>"
                          data-bs-toggle="modal"
                          data-bs-target="#modalFichaPedido">
                          <i class="fa fa-eye"></i> Ver ficha
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="text-center text-muted py-4">No hay pedidos completados.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Paginación Pedidos -->
          <div class="d-flex justify-content-between align-items-center mt-2" id="pagerPedidos">
            <div class="small text-muted" id="infoPedidos">Página 1 de 1</div>
            <div class="btn-group">
              <button class="btn btn-sm btn-outline-secondary" data-pager="pedidos-prev">&laquo; Anterior</button>
              <button class="btn btn-sm btn-outline-secondary" data-pager="pedidos-next">Siguiente &raquo;</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2: Devoluciones registradas -->
    <div class="tab-pane fade" id="tab-devoluciones" role="tabpanel" aria-labelledby="tab-devoluciones-tab" tabindex="0">
      <div class="card">
        <div class="card-body">
          <div class="row g-2 align-items-center mb-2">
            <div class="col-sm-6 col-md-4">
              <input id="searchDevs" type="text" class="form-control form-control-sm" placeholder="Buscar (ID, pedido, motivo, usuario, fecha)">
            </div>
            <div class="col-auto ms-auto d-flex align-items-center gap-2">
              <label class="form-label m-0 small">Filas por página</label>
              <select id="ppDevs" class="form-select form-select-sm" style="width:auto;">
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table table-sm table-striped align-middle" id="tblDevoluciones">
              <thead class="table-dark">
                <tr>
                  <th>ID</th>
                  <th>Pedido</th>
                  <th>Items</th>
                  <th>Total devueltos</th>
                  <th>Motivo</th>
                  <th>Creado por</th>
                  <th>Fecha</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% if (devoluciones && devoluciones.length) { %>
                  <% devoluciones.forEach(row => { %>
                    <tr>
                      <td>#<%= row.id %></td>
                      <td><a href="/pedidos/<%= row.pedido_id %>">Pedido #<%= row.pedido_id %></a></td>
                      <td><%= row.items || 0 %></td>
                      <td><%= row.total_items || 0 %></td>
                      <td class="text-truncate" style="max-width:250px;"><%= row.motivo_general || '—' %></td>
                      <td><%= row.creado_por || '—' %></td>
                      <td><%= new Date(row.created_at).toLocaleString() %></td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="/devoluciones-ventas/<%= row.id %>"><i class="fa fa-eye"></i> Ver</a>
                        <a class="btn btn-sm btn-outline-primary" href="/devoluciones-ventas/<%= row.id %>/editar"><i class="fa fa-edit"></i> Editar</a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="8" class="text-center text-muted py-4">No hay devoluciones registradas.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Paginación Devoluciones -->
          <div class="d-flex justify-content-between align-items-center mt-2" id="pagerDevs">
            <div class="small text-muted" id="infoDevs">Página 1 de 1</div>
            <div class="btn-group">
              <button class="btn btn-sm btn-outline-secondary" data-pager="devs-prev">&laquo; Anterior</button>
              <button class="btn btn-sm btn-outline-secondary" data-pager="devs-next">Siguiente &raquo;</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div> <!-- /tab-content -->
</div>

<!-- Modal Ficha de Pedido -->
<div class="modal fade" id="modalFichaPedido" tabindex="-1" aria-labelledby="modalFichaPedidoLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fa fa-file-invoice"></i> Ficha del pedido
          <span id="modalPedidoId" class="text-muted"></span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body p-0">
        <iframe id="iframeFicha" src="about:blank" style="border:0;width:100%;height:75vh;"></iframe>
      </div>
      <div class="modal-footer">
        <a id="linkAbrirNueva" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener">
          <i class="fa fa-external-link-alt"></i> Abrir en nueva pestaña
        </a>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  // ===== Modal "Ver ficha"
  document.querySelectorAll('.btn-ficha').forEach(btn => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-url');
      const pid = btn.getAttribute('data-pedido');
      document.getElementById('iframeFicha').src = url;
      document.getElementById('modalPedidoId').textContent = `#${pid}`;
      document.getElementById('linkAbrirNueva').href = url;
    });
  });

  // ===== Helpers
  const norm = s => (s||'').toString().toLowerCase()
    .normalize('NFD').replace(/\p{Diacritic}/gu,'');

  // ===== Paginador + Filtro (genérico)
  function PagerWithFilter(cfg){
    this.tbody   = cfg.tbody;
    this.infoEl  = cfg.infoEl;
    this.prevBtn = cfg.prevBtn;
    this.nextBtn = cfg.nextBtn;
    this.sizeSel = cfg.sizeSel;
    this.search  = cfg.searchInput;

    this.allRows = Array.from(this.tbody.querySelectorAll('tr'));
    this.filtered = this.allRows.slice();
    this.page = 1;
    this.perPage = parseInt(this.sizeSel.value, 10) || 10;

    this.applyFilter = () => {
      const q = norm(this.search.value);
      if (!q) {
        this.filtered = this.allRows.slice();
      } else {
        this.filtered = this.allRows.filter(tr => norm(tr.innerText).includes(q));
      }
      this.page = 1;
      this.update();
    };

    this.update = () => {
      const total = this.filtered.length;
      const pages = Math.max(1, Math.ceil(total / this.perPage));
      if (this.page > pages) this.page = pages;

      // Ocultar todas y mostrar el slice
      this.allRows.forEach(tr => tr.style.display = 'none');
      const start = (this.page - 1) * this.perPage;
      const end   = start + this.perPage;
      this.filtered.slice(start, end).forEach(tr => tr.style.display = '');

      this.infoEl.textContent = `Página ${this.page} de ${pages} — ${total} registros`;
      this.prevBtn.disabled = this.page <= 1;
      this.nextBtn.disabled = this.page >= pages;
    };

    this.prevBtn.addEventListener('click', () => { this.page--; this.update(); });
    this.nextBtn.addEventListener('click', () => { this.page++; this.update(); });
    this.sizeSel.addEventListener('change', () => { this.perPage = parseInt(this.sizeSel.value, 10) || 10; this.page = 1; this.update(); });
    this.search.addEventListener('input', this.applyFilter);

    // init
    this.update();
  }

  // Instancias: Pedidos y Devoluciones
  const pagerPedidos = new PagerWithFilter({
    tbody:    document.querySelector('#tblPedidos tbody'),
    infoEl:   document.getElementById('infoPedidos'),
    prevBtn:  document.querySelector('[data-pager="pedidos-prev"]'),
    nextBtn:  document.querySelector('[data-pager="pedidos-next"]'),
    sizeSel:  document.getElementById('ppPedidos'),
    searchInput: document.getElementById('searchPedidos')
  });

  const pagerDevs = new PagerWithFilter({
    tbody:    document.querySelector('#tblDevoluciones tbody'),
    infoEl:   document.getElementById('infoDevs'),
    prevBtn:  document.querySelector('[data-pager="devs-prev"]'),
    nextBtn:  document.querySelector('[data-pager="devs-next"]'),
    sizeSel:  document.getElementById('ppDevs'),
    searchInput: document.getElementById('searchDevs')
  });
})();
</script>

<%- include('../partials/footer') %>
