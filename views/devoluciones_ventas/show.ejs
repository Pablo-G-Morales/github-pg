<%- include('../partials/header', { title }) %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0"><i class="fa fa-receipt"></i> <%= title %></h2>
    <div class="d-flex gap-2">
      <a class="btn btn-sm btn-outline-primary" href="/devoluciones-ventas/<%= cab.id %>/editar">
        <i class="fa fa-edit"></i> Editar
      </a>
      <a class="btn btn-sm btn-outline-secondary" href="/devoluciones-ventas">
        <i class="fa fa-list"></i> Listado
      </a>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body">
          <div class="mb-1"><strong>Devolución:</strong> #<%= cab.id %></div>
          <div class="mb-1"><strong>Pedido:</strong> <a href="/pedidos/show/<%= cab.pedido_id %>">#<%= cab.pedido_id %></a></div>
          <div class="mb-1"><strong>Creado por:</strong> <%= cab.creado_por || '—' %></div>
          <div class="mb-1"><strong>Fecha:</strong> <%= new Date(cab.created_at).toLocaleString() %></div>
          <div class="mb-1"><strong>Motivo general:</strong> <%= cab.motivo_general || '—' %></div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <!-- Resumen rápido -->
      <div class="card h-100">
        <div class="card-body">
          <div class="fw-semibold mb-2">Resumen</div>
          <div>Total de renglones: <%= detalles.length %></div>
          <div>
            Total devuelto:
            <%= detalles.reduce((acc, x) => acc + Number(x.cantidad || 0), 0).toFixed(2) %> unidades
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-sm align-middle">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>Producto</th>
          <th class="text-end">Cantidad devuelta</th>
          <th>Detalle</th>
        </tr>
      </thead>
      <tbody>
        <% if (detalles && detalles.length) { %>
          <% detalles.forEach((it, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= it.product_nombre %> (ID <%= it.product_id %>)</td>
              <td class="text-end"><%= Number(it.cantidad).toFixed(2) %></td>
              <td><%= it.detalle || '—' %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="4" class="text-center text-muted py-3">Sin detalles.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
