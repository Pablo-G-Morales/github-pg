<%- include('partials/header', { title:'Dashboard', user }); %>

<%
  // Blindaje por si no llega "banners"
  const _banners = (typeof banners !== 'undefined' && Array.isArray(banners)) ? banners : [];
  const hero = _banners.length ? _banners[0] : null; // usamos el primero como imagen lateral
%>

<div class="row g-4 align-items-start">
  <!-- IZQUIERDA: título + tarjetas -->
  <div class="col-lg-8 order-lg-1">
    <h1 class="mb-2">📊 Dashboard</h1>
    <p class="lead mb-4">Bienvenido al sistema de gestión de SubliRex.</p>

    <div class="row">
      <% if (user?.rol_id === 1) { %>
      <!-- Usuarios (solo admin) -->
      <div class="col-md-6">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h5 class="card-title">Usuarios registrados</h5>
            <p class="card-text">Consulta, filtra y administra los usuarios del sistema.</p>
            <a href="/usuarios" class="btn btn-outline-primary">Ir al módulo de usuarios</a>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Pedidos -->
      <div class="col-md-6">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h5 class="card-title">Sistema de pedidos</h5>
            <p class="card-text">Visualiza y administra los pedidos personalizados.</p>
            <a href="/pedidos" class="btn btn-outline-success">Ir a pedidos</a>
          </div>
        </div>
      </div>

      <!-- Mi cuenta -->
      <div class="col-md-6">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h5 class="card-title">Mi cuenta</h5>
            <p class="card-text">Consulta tu ficha personal o cambia tu contraseña y foto.</p>
            <a href="/perfil" class="btn btn-outline-secondary me-2">Ver mi ficha</a>
            <a href="/perfil/editar" class="btn btn-outline-dark">Cambiar contraseña y foto</a>
          </div>
        </div>
      </div>

      <!-- Descontar insumos -->
      <div class="col-md-6">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h5 class="card-title">Descontar insumos</h5>
            <p class="card-text">Administra el stock de insumos por bodega y registra descuentos.</p>
            <a href="/insumos/descontar" class="btn btn-outline-warning">Ir a descontar insumos</a>
          </div>
        </div>
      </div>

      <% if (user?.rol_id === 1) { %>
      <!-- Cargar imagen (solo admin) -->
      <div class="col-md-6">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h5 class="card-title">Cargar imagen</h5>
            <p class="card-text">Sube una imagen al Dashboard principal para que todos puedan verla.</p>
            <a href="/admin/dashboard-imagenes" class="btn btn-outline-primary">Subir o cambiar imagen</a>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Soporte / Contactos (visible para todos) -->
      <div class="col-md-6">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h5 class="card-title">Soporte</h5>
            <p class="card-text">¿Necesitas ayuda o asesoramiento? Contáctanos.</p>
            <a href="/admin/contactos" class="btn btn-outline-primary">Ver contactos</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- DERECHA: imagen lateral alineada al título -->
  <div class="col-lg-4 order-lg-2">
    <% if (hero) { %>
      <div class="border-0">
        <img
          src="<%= hero.image_path %>"
          alt="<%= hero.titulo || 'banner' %>"
          class="img-fluid rounded shadow-sm"
          style="width:100%; max-height:520px; object-fit:cover; object-position:center; position:sticky; top:1rem;">
      </div>

      <!-- (Opcional) Si hay más banners, miniaturas debajo -->
      <% if (_banners.length > 1) { %>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <% _banners.slice(1, 4).forEach(b => { %>
            <img src="<%= b.image_path %>" alt="mini"
                 style="height:80px; width:auto; object-fit:contain;" class="rounded border">
          <% }) %>
        </div>
      <% } %>
    <% } %>
  </div>
</div>

<%- include('partials/footer'); %>
