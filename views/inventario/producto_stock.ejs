<%- include('../partials/header') %>

<link  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"/>

<style>
  .prod-card{border:1px solid #dee2e6;border-radius:.8rem;padding:1.2rem;background:#fff}
  .prod-img{width:100%;max-height:260px;object-fit:contain;margin-bottom:.5rem;background:#f8f9fa;border:1px dashed #dcdcdc;border-radius:.5rem}
  th,td{vertical-align:middle}
  .img-note{font-size:.85rem;color:#6c757d}
</style>

<div class="container my-4">

  <h1 class="text-center fw-bold"><%= producto.nombre %></h1>
  <% if(producto.descripcion){ %>
    <p class="text-center text-muted mb-4"><%= producto.descripcion %></p>
  <% } %>

  <div class="row g-4">

    <!-- Columna izquierda: imagen + datos básicos -->
    <aside class="col-lg-4">
      <div class="prod-card">

        <% 
          // Normalizar la ruta de imagen
          const rawImg = (producto.imagen || '').toString().trim();
          let imgSrc = '';
          if (rawImg) {
            if (rawImg.startsWith('http://') || rawImg.startsWith('https://') || rawImg.startsWith('/')) {
              imgSrc = rawImg;
            } else {
              // si viene "uploads/..." o "public/uploads/...", la exponemos desde / (public estático)
              imgSrc = '/' + rawImg.replace(/^public\//,'');
            }
          }
          const precioSugerido = (producto.precio_venta != null && producto.precio_venta !== '')
                                  ? Number(producto.precio_venta)
                                  : null;
        %>

        <% if(imgSrc){ %>
          <img src="<%= imgSrc %>" class="prod-img" alt="Producto"
               onerror="this.onerror=null;this.src='/img/placeholder-product.png';">
          <div class="img-note">Imagen: <code><%= imgSrc %></code></div>
        <% } else { %>
          <img src="/img/placeholder-product.png" class="prod-img" alt="Sin imagen">
          <div class="img-note">Sin imagen cargada</div>
        <% } %>

        <p class="fw-bold mb-2 mt-2">Producto</p>
        <p class="mb-1"><strong>Marca:</strong> <%= producto.marca||'—' %></p>
        <p class="mb-1"><strong>Material:</strong> <%= producto.material||'—' %></p>
        <p class="mb-1"><strong>Color:</strong> <%= producto.color||'—' %></p>
        <p class="mb-1"><strong>Forma:</strong> <%= producto.forma||'—' %></p>
        <% if(producto.capacidad){ %>
          <p class="mb-1"><strong>Capacidad:</strong> <%= producto.capacidad %> <%= producto.unidad||'' %></p>
        <% } %>
        <% if(precioSugerido !== null && !Number.isNaN(precioSugerido)){ %>
          <p class="mb-0"><strong>Precio Venta Sugerido:</strong> Q <%= precioSugerido.toFixed(2) %></p>
        <% } %>
      </div>
    </aside>

    <!-- Columna derecha: stock y precios -->
    <section class="col-lg-8">

      <h4 class="border-bottom pb-2 mb-3">Existencias por bodega</h4>
      <table class="table table-sm table-bordered mb-4">
        <thead class="table-light">
          <tr>
            <th>Bodega</th>
            <th class="text-end">Stock Disponible</th>
          </tr>
        </thead>
        <tbody>
          <% stocks.forEach(r=>{ %>
            <tr>
              <td><%= r.bodega %></td>
              <td class="text-end"><%= r.cantidad %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <h4 class="border-bottom pb-2 mb-3">Histórico de precios por proveedor</h4>
      <table class="table table-sm table-striped table-bordered">
        <thead class="table-light">
          <tr>
            <th>Proveedor</th>
            <th>Fecha Vigencia</th>
            <th class="text-end">Precio Compra&nbsp;(Q)</th>
            <th class="text-end">Precio Venta&nbsp;(Q)</th>
          </tr>
        </thead>
        <tbody>
          <% precios.forEach(p=>{ 
               const pc = (p.precio_compra != null) ? Number(p.precio_compra) : null;
               const pv = (p.precio_venta  != null) ? Number(p.precio_venta)  : null;
          %>
            <tr>
              <td><%= p.proveedor %></td>
              <td>
                <% if (p.fecha_vigencia && p.fecha_vigencia.toISOString) { %>
                  <%= p.fecha_vigencia.toISOString().substring(0,10) %>
                <% } else { %>
                  <%= p.fecha_vigencia ? String(p.fecha_vigencia).substring(0,10) : '—' %>
                <% } %>
              </td>
              <td class="text-end"><%= pc !== null && !Number.isNaN(pc) ? pc.toFixed(2) : '—' %></td>
              <td class="text-end"><%= pv !== null && !Number.isNaN(pv) ? pv.toFixed(2) : '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <a href="/inventario/stock" class="btn btn-secondary">
        <i class="fa fa-arrow-left"></i> Volver al listado
      </a>
    </section>
  </div>
</div>

<%- include('../partials/footer') %>
