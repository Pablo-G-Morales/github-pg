<%- include('../partials/header') %>

<!-- Select2 (opcional) -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet"/>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0"><%= prod.id ? 'Editar' : 'Nuevo' %> producto</h2>

    <!-- Botón para abrir modal con el módulo de inventario -->
    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalAtributos">
      <i class="fa fa-sliders"></i> Agrega atributos aquí
    </button>
  </div>

  <form action="<%= prod.id ? '/inventario/productos/' + prod.id + '/editar'
                             : '/inventario/productos/nuevo' %>"
        method="POST" enctype="multipart/form-data" class="row g-3">

    <!-- Nombre y Clasificación -->
    <div class="col-md-6">
      <label class="form-label">Nombre</label>
      <input name="nombre" required class="form-control" value="<%= prod.nombre || '' %>">
    </div>

    <div class="col-md-6">
      <label class="form-label">Clasificación</label>
      <select name="clase" class="form-select select2" required>
        <option value="PRODUCTO" <%= (prod.clase || 'PRODUCTO') === 'PRODUCTO' ? 'selected' : '' %>>Producto</option>
        <option value="INSUMO"   <%= (prod.clase || 'PRODUCTO') === 'INSUMO'   ? 'selected' : '' %>>Insumo</option>
      </select>
    </div>

    <!-- Marca y Material -->
    <div class="col-md-6">
      <label class="form-label">Marca</label>
      <select name="brand_id" class="form-select select2">
        <option value="">— Sin marca —</option>
        <% (marcas||[]).forEach(m => { %>
          <option value="<%= m.id %>" <%= m.id == prod.brand_id ? 'selected' : '' %>><%= m.nombre %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-md-6">
      <label class="form-label">Material</label>
      <select name="material_id" class="form-select select2">
        <option value="">— Seleccionar —</option>
        <% (materiales||[]).forEach(mat => { %>
          <option value="<%= mat.id %>" <%= mat.id == prod.material_id ? 'selected' : '' %>><%= mat.nombre %></option>
        <% }) %>
      </select>
    </div>

    <!-- Color y Forma -->
    <div class="col-md-6">
      <label class="form-label">Color</label>
      <select name="color_id" class="form-select select2">
        <option value="">— Seleccionar —</option>
        <% (colores||[]).forEach(c => { %>
          <option value="<%= c.id %>" <%= c.id == prod.color_id ? 'selected' : '' %>><%= c.nombre %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-md-6">
      <label class="form-label">Forma</label>
      <select name="shape_id" class="form-select select2">
        <option value="">— Seleccionar —</option>
        <% (formas||[]).forEach(f => { %>
          <option value="<%= f.id %>" <%= f.id == prod.shape_id ? 'selected' : '' %>><%= f.nombre %></option>
        <% }) %>
      </select>
    </div>

    <!-- Unidad / Capacidad -->
    <div class="col-md-4">
      <label class="form-label">Unidad</label>
      <select name="unit_id" class="form-select select2">
        <option value="">— Seleccionar —</option>
        <% (unidades||[]).forEach(u => { %>
          <option value="<%= u.id %>" <%= u.id == prod.unit_id ? 'selected' : '' %>><%= u.nombre %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-md-2">
      <label class="form-label">Capacidad</label>
      <input type="number" step="0.01" name="capacidad" class="form-control" value="<%= prod.capacidad || '' %>">
    </div>

    <!-- Precio venta sugerido -->
    <div class="col-md-6">
      <label class="form-label">Precio venta sugerido (Q) <span class="text-muted">(opcional)</span></label>
      <input type="number" step="0.01" name="precio_venta" class="form-control" value="<%= prod.precio_venta || '' %>">
    </div>

    <!-- Proveedores (múltiple) -->
    <div class="col-12">
      <label class="form-label">Proveedores vinculados</label>
      <select name="proveedores[]" class="form-select select2" multiple data-placeholder="Seleccione uno o varios proveedores">
        <% (proveedores||[]).forEach(p => { 
             const sel = (proveedoresSeleccionados||[]).includes(p.id);
        %>
          <option value="<%= p.id %>" <%= sel ? 'selected' : '' %>><%= p.nombre %></option>
        <% }) %>
      </select>
      <small class="text-muted">Este listado se usa para compras y precios por proveedor.</small>
    </div>

    <!-- Descripción -->
    <div class="col-12">
      <label class="form-label">Descripción</label>
      <textarea name="descripcion" rows="3" class="form-control"><%= prod.descripcion || '' %></textarea>
    </div>

    <!-- Imagen -->
    <div class="col-md-6">
      <label class="form-label">Imagen</label>
      <input type="file" name="img" accept="image/*" class="form-control">
      <% if (prod.imagen) { %>
        <img src="<%= prod.imagen %>" class="mt-2" style="width:80px;height:80px;object-fit:cover;">
      <% } %>
    </div>

    <!-- Botones -->
    <div class="col-12">
      <button class="btn btn-success"><i class="fa fa-save"></i> Guardar</button>
      <a href="/inventario/productos" class="btn btn-secondary ms-2">Cancelar</a>
    </div>
  </form>
</div>

<!-- Modal: Atributos (Inventario embebido) -->
<div class="modal fade" id="modalAtributos" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="fa fa-sliders me-2"></i>Administrar atributos de inventario
        </h5>
        <div class="d-flex align-items-center gap-2">
          <a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener"
             href="/inventario">
            Abrir en pestaña nueva
          </a>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
      </div>
      <div class="modal-body p-0">
        <!-- Usamos alta para aprovechar más área -->
        <div style="height: 75vh;">
          <iframe id="iframeInventario"
                  src="about:blank"
                  style="width:100%;height:100%;border:0;"
                  title="Inventario – Atributos">
          </iframe>
        </div>
      </div>
      <div class="modal-footer">
        <small class="text-muted me-auto">
          Aquí puedes crear/editar marcas, materiales, colores, formas y unidades. Luego vuelve y actualiza el formulario.
        </small>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<!-- Bootstrap (asegura el funcionamiento del modal) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  $('.select2').select2({ width: '100%' });

  // Carga perezosa del inventario en el iframe al abrir el modal,
  // y limpieza al cerrar para no dejar procesos abiertos.
  (function () {
    const modal = document.getElementById('modalAtributos');
    const iframe = document.getElementById('iframeInventario');
    const INVENTARIO_URL = 'http://localhost:3000/inventario';

    modal.addEventListener('show.bs.modal', () => {
      if (!iframe.src || iframe.src === 'about:blank') {
        iframe.src = INVENTARIO_URL;
      }
    });

    modal.addEventListener('hidden.bs.modal', () => {
      // Si prefieres mantenerlo cargado, comenta la siguiente línea:
      iframe.src = 'about:blank';
    });
  })();
</script>

<%- include('../partials/footer') %>
