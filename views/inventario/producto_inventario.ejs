<%- include('../partials/header', { title }) %>

<div class="container my-4">
  <h2><%= producto.nombre %></h2>

  <!-- Datos básicos del producto -->
  <div class="row mb-4">
    <div class="col-md-4">

      <%
        // ---------- Resolver imagen SOLO en EJS ----------
        const rawImg = (producto?.imagen ?? '').toString().trim();

        function resolveWebImg(src) {
          if (!src) return '';

          let s = String(src).trim();

          // 1) URLs absolutas o data/blob => devolver tal cual
          if (/^(https?:\/\/|data:|blob:)/i.test(s)) return s;

          // 2) Normalizar separadores Windows
          s = s.replace(/\\/g, '/');

          // 3) Quitar letra de unidad tipo "C:/"
          s = s.replace(/^[a-zA-Z]:\//, '/');

          // 4) Si contiene "/public/", cortar todo hasta después de "public/"
          const idxPub = s.toLowerCase().indexOf('/public/');
          if (idxPub >= 0) s = s.substring(idxPub + '/public/'.length);

          // 5) Si detectamos subcarpetas web típicas, cortar desde ahí
          const cutPoints = ['/img/', '/uploads/'];
          for (const kp of cutPoints) {
            const i = s.toLowerCase().indexOf(kp);
            if (i > 0) { s = s.substring(i + 1); break; } // quita lo anterior y el slash
          }

          // 6) Si quedó solo un nombre de archivo (sin '/'), asumir /img/products/
          if (!s.includes('/')) s = 'img/products/' + s;

          // 7) Asegurar slash inicial y colapsar dobles slashes
          if (!s.startsWith('/')) s = '/' + s;
          s = s.replace(/\/{2,}/g, '/');

          // 8) Si aún inicia con /public/, quitarlo
          if (s.toLowerCase().startsWith('/public/')) {
            s = s.substring('/public'.length); // deja "/..."
          }

          return s;
        }

        const imgSrc = resolveWebImg(rawImg);
      %>

      <% if (imgSrc) { %>
        <img src="<%= imgSrc %>" alt="<%= producto.nombre %>" class="img-fluid rounded border"
             onerror="this.onerror=null;this.src='/img/placeholder-product.png'">
        <!-- Diagnóstico (puedes quitarlo cuando todo funcione) -->
        <details class="text-muted small mt-2">
          <summary>Diagnóstico de imagen</summary>
          <div>DB: <code><%= rawImg %></code></div>
          <div>Resuelta: <code><%= imgSrc %></code></div>
          <div><a href="<%= imgSrc %>" target="_blank" rel="noopener">Abrir en nueva pestaña</a></div>
        </details>
      <% } else { %>
        <img src="/img/placeholder-product.png" alt="Sin imagen" class="img-fluid rounded border">
        <div class="text-muted small mt-2">Sin imagen cargada</div>
      <% } %>

    </div>

    <div class="col-md-8">
      <ul class="list-group">
        <li class="list-group-item"><strong>Marca:</strong> <%= producto.marca || '-' %></li>
        <li class="list-group-item"><strong>Material:</strong> <%= producto.material || '-' %></li>
        <li class="list-group-item"><strong>Color:</strong> <%= producto.color || '-' %></li>
        <li class="list-group-item"><strong>Forma:</strong> <%= producto.forma || '-' %></li>
        <li class="list-group-item"><strong>Unidad:</strong> <%= producto.unidad || '-' %></li>
        <li class="list-group-item"><strong>Capacidad:</strong> <%= producto.capacidad || '-' %></li>
      </ul>
    </div>
  </div>

  <!-- Existencias por bodega -->
  <h4>Existencias por bodega</h4>
  <div class="table-responsive mb-4">
    <table class="table table-sm table-striped align-middle">
      <thead class="table-dark">
        <tr>
          <th>Bodega</th>
          <th class="text-end">Stock disponible</th>
        </tr>
      </thead>
      <tbody>
        <% (stocks || []).forEach(i => { %>
          <tr>
            <td><%= i.bodega %></td>
            <td class="text-end"><%= i.stock %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Último precio por proveedor -->
  <h4>Último precio por proveedor</h4>
  <div class="table-responsive mb-4">
    <table class="table table-sm table-bordered align-middle">
      <thead class="table-dark">
        <tr>
          <th>Proveedor</th>
          <th>Precio compra (Q)</th>
          <th>Precio venta (Q)</th>
          <th>Fecha vigencia</th>
        </tr>
      </thead>
      <tbody>
        <% if ((ultimos || []).length) { %>
          <% ultimos.forEach(u => { %>
            <tr>
              <td><%= u.proveedor %></td>
              <td><%= Number(u.precio_compra).toFixed ? Number(u.precio_compra).toFixed(2) : u.precio_compra %></td>
              <td><%= (u.precio_venta != null && u.precio_venta !== '' && !Number.isNaN(Number(u.precio_venta))) ? Number(u.precio_venta).toFixed(2) : '-' %></td>
              <td><%= u.fecha_vigencia ? new Date(u.fecha_vigencia).toLocaleDateString() : '-' %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="4" class="text-center text-muted">Sin precios registrados</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Histórico de precios por proveedor -->
  <h4>Histórico de precios</h4>
  <div class="table-responsive mb-4">
    <table class="table table-sm table-striped align-middle">
      <thead class="table-dark">
        <tr>
          <th>Proveedor</th>
          <th>Precio compra (Q)</th>
          <th>Precio venta (Q)</th>
          <th>Fecha vigencia</th>
        </tr>
      </thead>
      <tbody>
        <% if ((historial || []).length) { %>
          <% historial.forEach(h => { %>
            <tr>
              <td><%= h.proveedor %></td>
              <td><%= Number(h.precio_compra).toFixed ? Number(h.precio_compra).toFixed(2) : h.precio_compra %></td>
              <td><%= (h.precio_venta != null && h.precio_venta !== '' && !Number.isNaN(Number(h.precio_venta))) ? Number(h.precio_venta).toFixed(2) : '-' %></td>
              <td><%= h.fecha_vigencia ? new Date(h.fecha_vigencia).toLocaleDateString() : '-' %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="4" class="text-center text-muted">Sin histórico disponible</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="mt-3">
    <a href="/inventario/stock" class="btn btn-outline-secondary">Volver al listado</a>
    <a href="/inventario/productos/<%= producto.id %>/inventario/nuevo" class="btn btn-success">+ Nuevo precio</a>
  </div>
</div>

<%- include('../partials/footer') %>
